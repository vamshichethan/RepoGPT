# ============================================================
# RepoGPT — Environment Variables Reference
# ============================================================
# Copy this file to .env in the backend/ directory and fill in your values.
# For production, set these in your Render/Vercel dashboard instead.
# ============================================================

# ── AI / LLM (Gemini via OpenAI-compatible endpoint) ────────
# Get your key from: https://aistudio.google.com/app/apikey
OPENAI_API_KEY=your-gemini-api-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
CHAT_MODEL=gemini-3.5-flash
SUMMARY_MODEL=gemini-3.5-flash

# ── GitHub (enables private repo access) ────────────────────
# Create a PAT at: https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_TOKEN=ghp_your-github-personal-access-token

# ── Database ─────────────────────────────────────────────────
# Local development (PostgreSQL running on localhost):
DATABASE_URL=postgresql+asyncpg://repogpt:repogpt@localhost:5432/repogpt
# Production (Render sets this automatically via the managed DB add-on)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Qdrant Vector Database ───────────────────────────────────
# Local: http://localhost:6333 (no key needed)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Qdrant Cloud (free): https://cloud.qdrant.io
# QDRANT_URL=https://xxxx.us-east-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-api-key

# ── Neo4j Knowledge Graph ────────────────────────────────────
# Local: bolt://localhost:7687 (no auth)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Neo4j Aura (free): https://console.neo4j.io
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-aura-password

# ── CORS ─────────────────────────────────────────────────────
# Local: allow all (*)
CORS_ORIGINS=*
# Production: set to your Vercel frontend URL
# CORS_ORIGINS=https://repogpt.vercel.app

# ── App Config ───────────────────────────────────────────────
WORKSPACE_DIR=./workspace
ENVIRONMENT=development

# ── Ingestion Limits ─────────────────────────────────────────
MAX_FILES=50000
MAX_REPO_SIZE_MB=500

# ── Frontend (Next.js) ───────────────────────────────────────
# Place this in frontend/.env.local for local dev
# For Vercel, set NEXT_PUBLIC_API_URL in the Vercel dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
